{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIHeritageShortStoryboard",
  "description": "Single source of truth contract for the AI Heritage Short filmmaking pipeline.",
  "type": "object",
  "required": [
    "project_metadata",
    "film_title",
    "story_description",
    "target_audience",
    "narration_language",
    "subtitle_language",
    "output_aspect_ratios",
    "character_references",
    "visual_style",
    "music_settings",
    "end_card_settings",
    "shots"
  ],
  "properties": {
    "project_metadata": {
      "type": "object",
      "required": ["project_name", "pipeline_version", "target_total_duration"],
      "properties": {
        "project_name": { "type": "string" },
        "pipeline_version": { "type": "string" },
        "target_total_duration": { "type": "number", "minimum": 60, "maximum": 90 },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": true
    },
    "film_title": {
      "type": "string",
      "minLength": 1
    },
    "story_description": {
      "type": "string",
      "minLength": 10
    },
    "target_audience": {
      "type": "string",
      "minLength": 3
    },
    "narration_language": {
      "type": "string",
      "enum": ["Amharic", "am-ET", "am"]
    },
    "subtitle_language": {
      "type": "string",
      "enum": ["English", "en-US", "en"]
    },
    "output_aspect_ratios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["9:16", "16:9", "1:1"]
      }
    },
    "character_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["character_id", "name", "description", "visual_traits"],
        "properties": {
          "character_id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "visual_traits": {
            "type": "object",
            "required": ["estimated_age", "attire", "facial_features"],
            "properties": {
              "estimated_age": { "type": "string" },
              "attire": { "type": "string" },
              "facial_features": { "type": "string" },
              "hair": { "type": "string" }
            },
            "additionalProperties": true
          },
          "reference_image_path": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "visual_style": {
      "type": "object",
      "required": ["art_style", "lighting", "color_palette", "camera_lens", "negative_prompt"],
      "properties": {
        "art_style": { "type": "string" },
        "lighting": { "type": "string" },
        "color_palette": { "type": "string" },
        "camera_lens": { "type": "string" },
        "film_grain": { "type": "string" },
        "negative_prompt": { "type": "string" }
      },
      "additionalProperties": true
    },
    "music_settings": {
      "type": "object",
      "required": ["prompt", "genre", "instrumentation", "tempo_bpm", "mood", "target_duration"],
      "properties": {
        "prompt": { "type": "string" },
        "genre": { "type": "string" },
        "instrumentation": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tempo_bpm": { "type": "integer", "minimum": 40, "maximum": 180 },
        "mood": { "type": "string" },
        "target_duration": { "type": "number", "minimum": 30 },
        "ducking_attenuation_db": { "type": "number" }
      },
      "additionalProperties": true
    },
    "end_card_settings": {
      "type": "object",
      "required": ["title", "disclosure_text", "duration_seconds"],
      "properties": {
        "title": { "type": "string" },
        "disclosure_text": { "type": "string" },
        "duration_seconds": { "type": "number", "minimum": 1.0, "maximum": 10.0 },
        "background_color": { "type": "string" },
        "font_color": { "type": "string" }
      },
      "additionalProperties": true
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "shot_id",
          "duration",
          "scene_description",
          "narration_amharic",
          "english_translation",
          "image_prompt",
          "motion_prompt",
          "camera_movement",
          "character_reference_ids",
          "visual_purpose",
          "generation_settings"
        ],
        "properties": {
          "shot_id": {
            "type": "string",
            "pattern": "^shot_[0-9]{2,}$"
          },
          "duration": {
            "type": "number",
            "minimum": 1.0,
            "maximum": 20.0
          },
          "scene_description": {
            "type": "string",
            "minLength": 5
          },
          "narration_amharic": {
            "type": "string"
          },
          "english_translation": {
            "type": "string"
          },
          "image_prompt": {
            "type": "string",
            "minLength": 10
          },
          "motion_prompt": {
            "type": "string",
            "minLength": 5
          },
          "camera_movement": {
            "type": "string"
          },
          "character_reference_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "visual_purpose": {
            "type": "string"
          },
          "generation_settings": {
            "type": "object",
            "properties": {
              "seed": { "type": ["integer", "null"] },
              "steps": { "type": "integer" },
              "guidance_scale": { "type": "number" },
              "motion_bucket_id": { "type": "integer" },
              "fps": { "type": "integer" }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

