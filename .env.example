# ==============================================================================
# AI Heritage Short - Environment Configuration Template
# ==============================================================================

# Pipeline Global Settings
PIPELINE_ENV=development
LOG_LEVEL=INFO
OUTPUT_DIR=outputs
CACHE_DIR=.cache
RUNS_LOG_PATH=runs.jsonl

# 1. Gemini API (Story development, script refinement, translation, Amharic TTS)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_TEXT=gemini-flash-latest
GEMINI_MODEL_TTS=gemini-2.5-flash-preview-tts
GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta

# 2. Cloudflare Workers AI (FLUX keyframe generation)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_FLUX_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4/accounts

# 3. Kaggle GPU Orchestration (Wan 2.2 TI2V-5B video, ACE-Step 1.5 music)
KAGGLE_USERNAME=your_kaggle_username_here
KAGGLE_KEY=your_kaggle_api_key_here
KAGGLE_WAN_NOTEBOOK_SLUG=username/wan-2-2-ti2v-heritage-short
KAGGLE_ACESTEP_NOTEBOOK_SLUG=username/ace-step-music-heritage-short

# 4. Media Processing (FFmpeg)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

